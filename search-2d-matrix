import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int row = sc.nextInt();
        int col = sc.nextInt();
        int arr[][] = new int[row][col];
        for(int r=0;r<row;r++){
            for(int c=0;c<col;c++){
                arr[r][c] = sc.nextInt();
            }
        }
        int target = sc.nextInt();
        boolean isFound = false;
       for(int r=0;r<row;r++){
            for(int c=0;c<col;c++){
                if(arr[r][c] == target){
                    isFound = true;
                    break;
                }
            }
            if(isFound){
                break;
            }
       }
       System.out.print(isFound);
    }
}
